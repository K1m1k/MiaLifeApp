<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/pinPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#33FFFFFF"
            android:gravity="center"
            android:hint="@string/pin_hint"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:textColor="#99FFFFFF"
            android:textColorHint="#33FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/pinConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:text="@string/dark_confirm"
            android:textColor="#80FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pinMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hiddenButton"
        android:layout_width="96dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/dark_hint"
        android:textColor="#26FFFFFF"
        android:textSize="20sp" />
</FrameLayout>
